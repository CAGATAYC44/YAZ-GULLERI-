# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_ — that prefix is
# what makes a variable available in the browser bundle. Anything without it
# stays on the server (API routes, middleware, Server Components) only.
# ---------------------------------------------------------------------------

# Password gate for /admin. Change this before deploying.
ADMIN_PASSWORD=

# Random string used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Future CMS / Supabase wiring (not used yet — src/lib/content/*.ts still
# reads from src/data/content.ts). When you connect a real backend:
#   - SUPABASE_SERVICE_ROLE_KEY must stay server-only, used only inside
#     src/lib/content/*.ts or API routes. Never pass it to a client component.
#   - The anon key is safe for the browser by design, hence NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
